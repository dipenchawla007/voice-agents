# Application settings
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database settings - Cloud SQL for PostgreSQL
DATABASE_URL=postgresql+pg8000://postgres:postgres@/voice_agents?unix_sock=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME/.s.PGSQL.5432
# If connecting locally for development
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voice_agents

# Security settings
JWT_SECRET=changethissecret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_API_KEY=ADMIN_API_KEY

# LiveKit settings
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional Redis for caching
REDIS_URL=redis://localhost:6379/0

# Default superadmin credentials (used during first-time setup)
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=changemeplease

# AI Services Keys
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Vector database
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX=voice-agent-kb

# Google Cloud Storage
GCP_PROJECT_ID=your-gcp-project-id
GCP_STORAGE_BUCKET=voice-agent-knowledge-base
GCP_CREDENTIALS_FILE=/path/to/service-account.json
# Or set GOOGLE_APPLICATION_CREDENTIALS in your environment

# Google Document AI
DOCUMENT_AI_ENABLED=true
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# Processor types: FORM_PARSER_PROCESSOR, GENERAL_DOCUMENT_PROCESSOR, etc.
DOCUMENT_AI_PROCESSOR_TYPE=GENERAL_DOCUMENT_PROCESSOR

# Application settings
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=changeme123 